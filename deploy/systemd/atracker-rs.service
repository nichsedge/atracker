[Unit]
Description=Activity Tracker Daemon (Rust)
After=graphical-session.target

[Service]
Type=simple
ExecStart=/home/al/Projects/atracker/atracker-rs/target/release/atracker-rs
WorkingDirectory=/home/al/Projects/atracker/atracker-rs
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

[Install]
WantedBy=default.target
